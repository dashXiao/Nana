# 阿里云百炼 DashScope API Key
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-key-here

# OpenAI 兼容端点
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主模型：ReAct 主循环用（function calling + 最终答复）
LLM_MODEL=qwen-plus

# 轻量模型：路由分类 / 记忆摘要用（便宜 + 快；PLAN §9 #11）
LLM_LIGHT_MODEL=qwen-turbo

# 计价（¥ / 百万 tokens，"input,output"）；harness 成本估算用
LLM_MODEL_PRICING=4.0,12.0
LLM_LIGHT_MODEL_PRICING=0.6,2.0

# 本地 SQLite 路径（相对项目根）
NANA_DB_PATH=db/nana.db
