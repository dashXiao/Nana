# Alibaba Cloud Model Studio API key; create one at https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-key-here

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Main model
LLM_MODEL=qwen3.7-plus

# Lightweight model
LLM_LIGHT_MODEL=qwen3.8-flash

# Explicit non-thinking mode for low-latency, synchronous tool calling
LLM_ENABLE_THINKING=false

# Optional
# Approximate Beijing/global text rates (CNY per million input/output tokens).
# Main-model rates cover the first context tier (up to 256K input tokens).
# Excludes promotions and cache discounts; verify rates for your region.
LLM_MODEL_PRICING=2.0,8.0
LLM_LIGHT_MODEL_PRICING=0.8,2.7

# SQLite database path
NANA_DB_PATH=db/nana.db
