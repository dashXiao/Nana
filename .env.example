# 阿里云百炼 API Key, 获取地址 https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-key-here

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主模型
LLM_MODEL=qwen-plus

# 轻量模型
LLM_LIGHT_MODEL=qwen-turbo

# Optional
# 计价，成本估算用
LLM_MODEL_PRICING=4.0,12.0
LLM_LIGHT_MODEL_PRICING=0.6,2.0

# SQLite 路径
NANA_DB_PATH=db/nana.db
